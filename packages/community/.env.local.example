# Error Report Proxy Configuration
# In production, error reports are sent to a server-side proxy that creates
# GitHub issues without exposing the token in the client-side bundle.
PLASMO_PUBLIC_ERROR_REPORT_PROXY_URL=https://engram.fly.dev/api/error-report

# ---- Development only (NOT bundled into the extension) ----
# These env vars intentionally lack the PLASMO_PUBLIC_ prefix so Plasmo
# does NOT bundle them into the client-side code. They are only used when
# running tests or developing locally.

# GitHub Personal Access Token (with 'repo' scope)
# Create at: https://github.com/settings/tokens/new
GITHUB_REPORTER_TOKEN=ghp_your_token_here

# GitHub Repository Owner (your username or organization)
GITHUB_REPO_OWNER=ramc10

# GitHub Repository Name
GITHUB_REPO_NAME=engram-community
